# Will override all database passwords (required).
NMCP_DATABASE_PW=

# InfluxDB password for the admin user (required).
NMCP_INFLUX_DB_PASSWORD=

NMCP_INFLUX_DB_TOKEN=

# Customize Compose project/container prefix.
NMCP_COMPOSE_PROJECT=

# Will be mapped to /var/log/nmcp in most service containers for log files.  Could be a host location or a docker volume.
NMCP_LOG_VOLUME=

# Compose services file to use (e.g., docker-compose.services.yml or docker-compose.services.staging.yml).
NMCP_SERVICES_FILE=

# Auth secret for internal services for env var in nmcp-api and precomputed-worker
NMCP_AUTH_CLIENT_ID=

# Location of ontology files for mapped volume into nmcp-api
NMCP_ONTOLOGY_LOCATION=

# CCFv3 file for mapped volume into nmcp-api.
NMCP_ONTOLOGY_PATH=

# Output for precomputed files for precomputed-worker.
NMCP_PRECOMPUTED_OUTPUT=

# Location of any secrets files for CloudVolumes package for mapped volume into precomputed-worker
NMCP_SECRETS_VOLUME=

# AAD Authentication
NMCP_AUTHENTICATION_CLIENT_ID=

# URL of the NMCP website generated DOI url will reference, e.g. https://morphology.allenneuraldynamics.org/
NMCP_DOI_URL=

# Host of the DataCite API server (generally the production or test API server)
NMCP_DOI_HOST=

# NMCP DOI prefix (production or test value as appropriate)
NMCP_DOI_PREFIX=

# DataCite API user credential
NMCP_DOI_USER=

# DataCite API password credential
NMCP_DOI_PASSWORD=

# DOI handler when showing a DOI link.  Generally https://dois.org for production or https://handle.test.datacite.org
# for test.
NMCP_DOI_HANDLER=
